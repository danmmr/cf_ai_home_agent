{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-home-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // every request hits the Worker first so plain http can be redirected to https
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "class_name": "HealthAgent", "name": "HealthAgent" }]
  },
  "migrations": [{ "new_sqlite_classes": ["HealthAgent"], "tag": "v1" }],
  "workflows": [
    {
      "name": "cf-ai-home-agent-triage",
      "binding": "TRIAGE_WORKFLOW",
      "class_name": "TriageWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
